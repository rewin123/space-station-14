#!/usr/bin/env bash
# Integration benchmarks for the LLM Station AI.
#
#   Tools/aibench                       # the fast deterministic suite
#   Tools/aibench Look                  # by name substring
#   Tools/aibench --scenario            # player scenarios on a REAL station (Box), ~15s per case
#   Tools/aibench --live                # behavioural, needs the model
#   Tools/aibench --socket              # the one test that binds a real port
#   Tools/aibench --no-build            # skip the build step
#
# NO_PROXY is forced because this box exports a global HTTP_PROXY that swallows localhost.
#
# The behavioural suite needs a model. It reads AI_ENDPOINT / AI_MODEL / AI_API_KEY from the
# environment, so the same scenarios can be pointed at a hosted provider or at a local llama-swap
# without editing anything. If a key file is lying around next to the agent's own data, use it —
# beats retyping a secret into a shell that keeps history.
set -euo pipefail

cd "$(dirname "$0")/.."

export DOTNET_ROOT="${DOTNET_ROOT:-$HOME/.dotnet}"
export PATH="$DOTNET_ROOT:$PATH"
export NO_PROXY='*' no_proxy='*'

if [[ -z "${AI_API_KEY:-}" && -r ai_data/deepseek.key ]]; then
    AI_API_KEY="$(cat ai_data/deepseek.key)"
    export AI_API_KEY
fi

FILTER=""
CATEGORY=""
BUILD_ARGS=()

for arg in "$@"; do
    case "$arg" in
        --no-build) BUILD_ARGS+=("--no-build") ;;
        # Behavioural benchmarks against the real model. Separate from the deterministic suite
        # because they need a GPU, take minutes, and are inherently a bit flaky.
        --live)     CATEGORY="Live" ;;
        # Player scenarios on a full station map. Each one loads Box from scratch — about
        # fifteen seconds apiece — so they are deliberately out of the per-commit run.
        --scenario) CATEGORY="Scenario" ;;
        # The debug endpoint over a real socket. Out of the default run because the pool reuses
        # server instances in one process, and a leaked listener fails whichever test binds NEXT.
        --socket)   CATEGORY="AiBusSocket" ;;
        # Everything that runs without a model and without a map load. The CI default.
        --fast)     CATEGORY="!Live" ;;
        -*)         BUILD_ARGS+=("$arg") ;;
        *)          FILTER="$arg" ;;
    esac
done

ARGS=(test Content.AiBench/Content.AiBench.csproj -c Release "${BUILD_ARGS[@]+"${BUILD_ARGS[@]}"}")

if [[ -n "$FILTER" ]]; then
    ARGS+=(--filter "FullyQualifiedName~$FILTER")
elif [[ "$CATEGORY" == "Live" ]]; then
    ARGS+=(--filter "TestCategory=Live")
elif [[ "$CATEGORY" == "Scenario" ]]; then
    ARGS+=(--filter "TestCategory=Scenario")
elif [[ "$CATEGORY" == "AiBusSocket" ]]; then
    ARGS+=(--filter "TestCategory=AiBusSocket")
else
    # Default: neither the model, nor a map load, nor a bound port.
    ARGS+=(--filter "TestCategory!=Live&TestCategory!=Scenario&TestCategory!=AiBusSocket")
fi

# One worker: the pool hands out real server instances, and running them in parallel makes
# failures interleave into an unreadable mess for no wall-clock gain worth having.
exec dotnet "${ARGS[@]}" -- NUnit.NumberOfTestWorkers=1
