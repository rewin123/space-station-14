# NODE_ENV=production is set machine-wide on this box, and npm reads that as `omit=dev`.
#
# A plain `npm install` therefore pulls vue but silently skips vite, vitest and vue-tsc, and the
# first sign of it is `npm run dev` failing with "vite: not found" — which looks like a broken
# lockfile rather than an environment variable. `include` beats `omit` regardless of order, so
# pinning it here makes a fresh checkout work without anyone having to know that.
include=dev
