# Bridge to the Grok subscription. Installation:
#   cp Tools/grokbridge/grok-bridge.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now grok-bridge
#
# A user unit, like ss14-aksioma and llama-swap: root is unreachable from the sandbox on this
# machine, and unnecessary anyway — the bridge listens on loopback and reads files from the
# home directory.

[Unit]
Description=Мост OpenAI-совместимого API к подписке Grok (для ss14-aksioma)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/rewin/projects/ss14_ai/Tools/grokbridge/grokbridge.py
WorkingDirectory=/home/rewin/projects/ss14_ai/Tools/grokbridge

# The proxy is deliberately NOT inherited. A user unit already doesn't see shell variables
# anyway, but it's worth writing down: auth.x.ai and cli-chat-proxy.grok.com respond directly,
# and an extra hop is just one more reason login could hang someday with no explanation. If a
# route through Germany is ever needed, it's turned on with one line:
#   Environment=GROK_BRIDGE_PROXY=http://127.0.0.1:10809
Environment=GROK_BRIDGE_BIND=127.0.0.1:8318
Environment=GROK_BRIDGE_SESSION=/home/rewin/projects/ss14_ai/ai_data/grok.session.json
Environment=GROK_BRIDGE_KEY=/home/rewin/projects/ss14_ai/ai_data/grok_bridge.key
Environment=PYTHONUNBUFFERED=1

Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
